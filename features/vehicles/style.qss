/* =========================================
   VEHICLE REGISTRATION PAGE
   ========================================= */

QWidget#vehicleView {
    background-color: #ffffff;
}


/* =========================================
   LABELS
   ========================================= */

QWidget#vehicleView QLabel {
    color: #374151;
    font-size: 13px;
    font-weight: 500;
}


/* =========================================
   INPUT FIELDS
   ========================================= */

QWidget#vehicleView QLineEdit,
QWidget#vehicleView QComboBox,
QWidget#vehicleView QSpinBox,
QWidget#vehicleView QDateEdit {
    background-color: #ffffff;
    color: #111827;

    border: 1px solid #cbd5e1;
    border-radius: 6px;

    padding: 7px 9px;
    min-height: 20px;

    font-size: 13px;
}


/* Focus */

QWidget#vehicleView QLineEdit:focus,
QWidget#vehicleView QComboBox:focus,
QWidget#vehicleView QSpinBox:focus,
QWidget#vehicleView QDateEdit:focus {
    border: 1px solid #2563eb;
}


/* Hover */

QWidget#vehicleView QLineEdit:hover,
QWidget#vehicleView QComboBox:hover,
QWidget#vehicleView QSpinBox:hover,
QWidget#vehicleView QDateEdit:hover {
    border: 1px solid #94a3b8;
}


/* =========================================
   COMBOBOX DROPDOWN
   ========================================= */

QWidget#vehicleView QComboBox {
    padding-right: 25px;
}

QWidget#vehicleView QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #111827;

    border: 1px solid #cbd5e1;

    selection-background-color: #2563eb;
    selection-color: #ffffff;
}


/* =========================================
   SPINBOX / DATE EDIT BUTTONS
   ========================================= */

QWidget#vehicleView QSpinBox::up-button,
QWidget#vehicleView QSpinBox::down-button,
QWidget#vehicleView QDateEdit::up-button,
QWidget#vehicleView QDateEdit::down-button {
    background-color: #f3f4f6;
    border-left: 1px solid #cbd5e1;
    width: 20px;
}


/* =========================================
   PRIMARY BUTTON
   ========================================= */

QWidget#vehicleView QPushButton#primaryButton {
    background-color: #2563eb;
    color: #ffffff;

    border: none;
    border-radius: 6px;

    padding: 9px 16px;

    font-size: 13px;
    font-weight: 600;
}

QWidget#vehicleView QPushButton#primaryButton:hover {
    background-color: #1d4ed8;
}

QWidget#vehicleView QPushButton#primaryButton:pressed {
    background-color: #1e40af;
}


/* =========================================
   SECONDARY BUTTON
   ========================================= */

QWidget#vehicleView QPushButton#secondaryButton {
    background-color: #e5e7eb;
    color: #111827;

    border: none;
    border-radius: 6px;

    padding: 9px 16px;

    font-size: 13px;
    font-weight: 500;
}

QWidget#vehicleView QPushButton#secondaryButton:hover {
    background-color: #d1d5db;
}

QWidget#vehicleView QPushButton#secondaryButton:pressed {
    background-color: #cbd5e1;
}


/* =========================================
   DELETE BUTTON
   ========================================= */

QWidget#vehicleView QPushButton#dangerButton {
    background-color: #dc2626;
    color: #ffffff;

    border: none;
    border-radius: 6px;

    padding: 9px 16px;

    font-size: 13px;
    font-weight: 600;
}

QWidget#vehicleView QPushButton#dangerButton:hover {
    background-color: #b91c1c;
}

QWidget#vehicleView QPushButton#dangerButton:pressed {
    background-color: #991b1b;
}


/* =========================================
   TABLE
   ========================================= */

QWidget#vehicleView QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f9fafb;

    color: #111827;

    border: 1px solid #d1d5db;
    border-radius: 4px;

    gridline-color: #e5e7eb;

    font-size: 12px;

    selection-background-color: #dbeafe;
    selection-color: #111827;
}


/* =========================================
   TABLE HEADER
   ========================================= */

QWidget#vehicleView QHeaderView {
    background-color: #f3f4f6;
}

QWidget#vehicleView QHeaderView::section {
    background-color: #f3f4f6;

    color: #374151;

    padding: 8px;

    border: none;
    border-right: 1px solid #d1d5db;
    border-bottom: 1px solid #d1d5db;

    font-size: 12px;
    font-weight: 600;
}


/* =========================================
   TABLE CORNER
   ========================================= */

QWidget#vehicleView QTableCornerButton::section {
    background-color: #f3f4f6;

    border: none;
    border-right: 1px solid #d1d5db;
    border-bottom: 1px solid #d1d5db;
}


/* =========================================
   SCROLLBARS
   ========================================= */

QWidget#vehicleView QScrollBar:vertical {
    background-color: #f3f4f6;
    width: 12px;
    margin: 0;
}

QWidget#vehicleView QScrollBar::handle:vertical {
    background-color: #cbd5e1;
    border-radius: 6px;
    min-height: 25px;
}

QWidget#vehicleView QScrollBar::handle:vertical:hover {
    background-color: #94a3b8;
}

QWidget#vehicleView QScrollBar:horizontal {
    background-color: #f3f4f6;
    height: 12px;
    margin: 0;
}

QWidget#vehicleView QScrollBar::handle:horizontal {
    background-color: #cbd5e1;
    border-radius: 6px;
    min-width: 25px;
}

QWidget#vehicleView QScrollBar::handle:horizontal:hover {
    background-color: #94a3b8;
}


/* =========================================
   MESSAGE BOXES
   ========================================= */

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #111827;
    background-color: transparent;

    font-size: 13px;
}

QMessageBox QPushButton {
    background-color: #2563eb;
    color: #ffffff;

    border: none;
    border-radius: 6px;

    padding: 7px 18px;
    min-width: 70px;

    font-size: 13px;
    font-weight: 600;
}

QMessageBox QPushButton:hover {
    background-color: #1d4ed8;
}

QMessageBox QPushButton:pressed {
    background-color: #1e40af;
}